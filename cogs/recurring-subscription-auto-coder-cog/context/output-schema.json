{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "output-schema.json",
  "title": "Recurring subscription auto-coder result",
  "description": "The normative contract for `pixi run code` output. Each transaction is in the shared shape, plus this Cog's inferred keys.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run",
    "transactions",
    "expected_but_missing",
    "unmatched_descriptors",
    "unparsed"
  ],
  "properties": {
    "run": {
      "type": "object",
      "required": [
        "cog",
        "version",
        "transaction_shape",
        "at",
        "mode",
        "binding",
        "inputs",
        "columns",
        "context",
        "tolerance",
        "counts",
        "abstention_rate",
        "warnings"
      ],
      "properties": {
        "cog": {
          "const": "recurring-subscription-auto-coder-cog"
        },
        "version": {
          "type": "string"
        },
        "transaction_shape": {
          "const": "0.2.0"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "mode": {
          "enum": [
            "strict",
            "model"
          ]
        },
        "binding": {
          "description": "null in strict mode. Otherwise endpoint, model requested, model echoed, and where the binding was resolved from.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "endpoint",
                "model_requested",
                "model_echoed",
                "source"
              ]
            }
          ]
        },
        "inputs": {
          "type": "object",
          "required": [
            "month",
            "history"
          ]
        },
        "context": {
          "type": "object"
        },
        "tolerance": {
          "type": "number"
        },
        "counts": {
          "type": "object"
        },
        "abstention_rate": {
          "type": [
            "number",
            "null"
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "columns": {
          "description": "How much of each export was read. Column names and counts only.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "file",
              "read",
              "ignored",
              "optional_missing"
            ],
            "properties": {
              "read": {
                "type": "integer"
              },
              "ignored": {
                "type": "integer"
              },
              "optional_missing": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "transactions": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "transaction.schema.json"
          },
          {
            "properties": {
              "inferred": {
                "required": [
                  "vendor",
                  "recurrence",
                  "coding"
                ],
                "properties": {
                  "recurrence": {
                    "type": "object",
                    "required": [
                      "label",
                      "reason",
                      "source",
                      "evidence",
                      "billing",
                      "amount_flag",
                      "why_subscription"
                    ],
                    "properties": {
                      "label": {
                        "enum": [
                          "recurring",
                          "likely-recurring",
                          "amount-changed",
                          "new",
                          "one-off"
                        ]
                      },
                      "source": {
                        "enum": [
                          "history",
                          "context",
                          "export"
                        ]
                      },
                      "billing": {
                        "enum": [
                          "usage",
                          "fixed"
                        ]
                      },
                      "amount_flag": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "why_subscription": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "coding": {
                    "description": "The QuickBooks entry for a subscription charge, or why there isn't one.",
                    "type": "object",
                    "required": [
                      "status",
                      "source"
                    ],
                    "properties": {
                      "status": {
                        "enum": [
                          "ready",
                          "waiting-for-post",
                          "not-included"
                        ]
                      }
                    },
                    "if": {
                      "properties": {
                        "status": {
                          "const": "ready"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "entry",
                        "from",
                        "blank",
                        "review"
                      ],
                      "properties": {
                        "source": {
                          "enum": [
                            "rule",
                            "export"
                          ]
                        },
                        "entry": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "DATE",
                            "REF NO.",
                            "TYPE",
                            "PAYEE",
                            "ACCOUNT",
                            "MEMO",
                            "CLASS",
                            "DEPARTMENT",
                            "CHARGE"
                          ],
                          "properties": {
                            "DATE": {
                              "type": "string"
                            },
                            "REF NO.": {
                              "type": "string"
                            },
                            "TYPE": {
                              "type": "string"
                            },
                            "PAYEE": {
                              "type": "string"
                            },
                            "ACCOUNT": {
                              "type": "string"
                            },
                            "MEMO": {
                              "type": "string"
                            },
                            "CLASS": {
                              "type": "string"
                            },
                            "DEPARTMENT": {
                              "type": "string"
                            },
                            "CHARGE": {
                              "type": "string"
                            }
                          }
                        },
                        "from": {
                          "type": "object",
                          "required": [
                            "DATE",
                            "REF NO.",
                            "TYPE",
                            "PAYEE",
                            "ACCOUNT",
                            "MEMO",
                            "CLASS",
                            "DEPARTMENT",
                            "CHARGE"
                          ],
                          "additionalProperties": {
                            "enum": [
                              "rule",
                              "export",
                              "context",
                              "none"
                            ]
                          }
                        },
                        "blank": {
                          "type": "array",
                          "items": {
                            "enum": [
                              "DATE",
                              "REF NO.",
                              "TYPE",
                              "PAYEE",
                              "ACCOUNT",
                              "MEMO",
                              "CLASS",
                              "DEPARTMENT",
                              "CHARGE"
                            ]
                          }
                        },
                        "review": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      }
                    },
                    "else": {
                      "required": [
                        "reason"
                      ],
                      "properties": {
                        "source": {
                          "const": "none"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "expected_but_missing": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "vendor",
          "known_recurring",
          "months_seen",
          "last_amount"
        ]
      }
    },
    "unmatched_descriptors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unparsed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "file",
          "row",
          "reason"
        ]
      }
    }
  }
}
