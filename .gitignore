# pixi environments
.pixi/
__pycache__/
.pytest_cache/
*.egg-info/

# Per-machine model binding, written by `pixi run use`. Holds no key, but it
# describes one person's setup.
model.json

# Real statements and exports never go in the repo. Put them in private/.
private/
*.pdf

# Results written by `pixi run code`. They contain transaction rows.
output/

# The chase-list builder's record of what was sent. Holds card, merchant,
# date and amount for each chased charge.
chase-log.json
